[package]
name = "scour-search"
version = "0.1.0"
edition = "2021"
description = "Embeddable hybrid search primitives: BM25 with Porter stemming, an HNSW vector index, reciprocal-rank fusion, and UTF-8-safe text chunking. Zero dependencies."
license = "MIT"
repository = "https://github.com/SA-Ark/scour"
keywords = ["search", "bm25", "hnsw", "vector", "rag"]
categories = ["text-processing", "algorithms", "data-structures"]
readme = "README.md"

[lib]
name = "scour"

# Live demo server (zero-dependency, std-only): indexes the seeded corpus and
# serves BM25 / vector / RRF-fused lanes plus the single-page UI.
#   cargo run --release --bin scour-demo
[[bin]]
name = "scour-demo"
path = "src/bin/serve.rs"

[dependencies]
# none — and that's the point

[profile.release]
lto = true
